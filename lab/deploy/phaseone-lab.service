[Unit]
Description=PHASEONE E2B controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=phaseone
Group=phaseone
WorkingDirectory=/opt/phaseone10841
EnvironmentFile=/etc/phaseone-lab.env
ExecStart=/opt/phaseone10841/.venv/bin/python /opt/phaseone10841/lab/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/phaseone-lab

[Install]
WantedBy=multi-user.target
