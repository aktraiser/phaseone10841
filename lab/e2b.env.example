# Configure on the controller VPS, not in the website or a sandbox.
PHASEONE_LAB_BACKEND=e2b
PHASEONE_LAB_MODE=controlled
PHASEONE_LAB_STATE=/var/lib/phaseone-lab
PHASEONE_LAB_PORT=18081
E2B_API_KEY=REPLACE_WITH_PRIVATE_E2B_KEY
E2B_TEMPLATE=base
# Prefer stable named access keys for multiple agents (see docs/E2B.md).
PHASEONE_LAB_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PHASEONE_LIMIT_TTL=600
PHASEONE_LIMIT_IDLE=120
PHASEONE_LIMIT_CONCURRENT=2
PHASEONE_LIMIT_PER_ACCESS=1
PHASEONE_LIMIT_STARTS_10M=2
PHASEONE_LIMIT_STARTS_HOUR=6
PHASEONE_LIMIT_MINUTES_HOUR=60
PHASEONE_LIMIT_MINUTES_DAY=120
PHASEONE_LIMIT_COMMANDS_MINUTE=12
PHASEONE_LIMIT_COMMANDS_VISIT=64
PHASEONE_LIMIT_COMMAND_SECONDS=30
PHASEONE_ADMISSION_DISABLED=0
